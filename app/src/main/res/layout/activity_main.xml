<?xml version="1.0" encoding="utf-8"?>
<!-- Native radio UI; approved reference is image-gen-3. Live data and all original action IDs are retained. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#030B14" android:orientation="vertical" android:paddingStart="10dp" android:paddingTop="6dp" android:paddingEnd="10dp" android:paddingBottom="6dp" android:weightSum="100">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="12" android:background="@drawable/future_header" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="12dp" android:paddingTop="4dp" android:paddingBottom="4dp">
        <ImageView android:layout_width="34dp" android:layout_height="match_parent" android:layout_marginEnd="8dp" android:src="@drawable/future_logo" android:contentDescription="@null" android:scaleType="fitCenter"/>
        <TextView android:id="@+id/logo" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="sans-serif-black" android:textStyle="italic|bold" android:textColor="#F3F8FF" android:textSize="19sp" android:singleLine="true"/>
        <TextClock android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="h:mm a" android:format24Hour="HH:mm" android:textColor="#F3F8FF" android:textSize="21sp" android:textStyle="bold"/>
        <TextView android:id="@+id/date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_marginEnd="10dp" android:textColor="#91B8D0" android:textSize="12sp" android:singleLine="true"/>
        <ImageView android:id="@+id/wifi" android:layout_width="18dp" android:layout_height="18dp" android:layout_marginEnd="10dp" android:contentDescription="Wi-Fi" android:src="@drawable/ic_wifi" android:tint="#91B8D0"/>
        <ImageView android:id="@+id/bt" android:layout_width="18dp" android:layout_height="18dp" android:contentDescription="Bluetooth" android:src="@drawable/ic_bt" android:tint="#00D5FF"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="70" android:orientation="horizontal" android:layout_marginTop="7dp" android:layout_marginBottom="7dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="30" android:background="@drawable/future_panel" android:orientation="vertical" android:padding="12dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Navegación" android:textColor="#F3F8FF" android:textSize="17sp" android:textStyle="bold" android:drawableStart="@drawable/ic_nav" android:drawablePadding="8dp" android:drawableTint="#00D5FF"/>
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:layout_marginBottom="6dp">
                <com.donpinol.car.MapDecorView android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|start" android:layout_margin="6dp" android:padding="6dp" android:background="@drawable/future_mini" android:text="Mapa externo" android:textColor="#91B8D0" android:textSize="11sp"/>
            </FrameLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal">
              <TextView android:id="@+id/btnHome" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:minHeight="44dp" android:background="@drawable/future_control" android:clickable="true" android:focusable="true" android:drawableStart="@drawable/ic_home" android:drawableTint="#FF9B32" android:drawablePadding="4dp" android:gravity="center" android:text="Casa" android:textSize="14sp" android:textStyle="bold" android:textColor="#F3F8FF"/>
              <TextView android:id="@+id/btnWork" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:minHeight="44dp" android:background="@drawable/future_control" android:clickable="true" android:focusable="true" android:drawableStart="@drawable/ic_work" android:drawableTint="#FF9B32" android:drawablePadding="4dp" android:gravity="center" android:text="Trabajo" android:textSize="14sp" android:textStyle="bold" android:textColor="#F3F8FF"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/btnOpenMap" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="5dp" android:background="@drawable/future_control" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="horizontal">
                <ImageView android:layout_width="19dp" android:layout_height="19dp" android:layout_marginEnd="7dp" android:src="@drawable/ic_nav" android:tint="#00D5FF" android:contentDescription="@null"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Abrir mapa" android:textColor="#F3F8FF" android:textSize="14sp" android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/speedCard" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="40" android:layout_marginStart="5dp" android:layout_marginEnd="5dp" android:orientation="vertical" android:gravity="center_horizontal">
            <com.donpinol.car.GaugeView android:id="@+id/gauge" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="59" android:contentDescription="Velocidad GPS"/>
            <ImageView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="34" android:src="@drawable/future_road_scene" android:scaleType="fitCenter" android:contentDescription="@null" android:importantForAccessibility="no"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal" android:paddingStart="3dp" android:paddingEnd="3dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/future_mini" android:orientation="vertical" android:gravity="center" android:paddingTop="3dp" android:paddingBottom="3dp">
                  <TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:text="RUMBO" android:textColor="#91B8D0" android:textSize="10sp" android:gravity="center"/>
                  <TextView android:id="@+id/heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="--" android:textColor="#F3F8FF" android:textSize="15sp" android:textStyle="bold" android:gravity="center" android:singleLine="true"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/tripBox" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="3dp" android:background="@drawable/future_mini" android:orientation="vertical" android:gravity="center" android:paddingTop="3dp" android:paddingBottom="3dp" android:clickable="true" android:focusable="true">
                  <TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:text="VIAJE" android:textColor="#91B8D0" android:textSize="10sp" android:gravity="center"/>
                  <TextView android:id="@+id/trip" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0.0 km" android:textColor="#F3F8FF" android:textSize="15sp" android:textStyle="bold" android:gravity="center" android:singleLine="true"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/musicCard" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="30" android:background="@drawable/future_panel" android:orientation="vertical" android:padding="12dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Música" android:textColor="#F3F8FF" android:textSize="17sp" android:textStyle="bold" android:drawableStart="@drawable/ic_music" android:drawablePadding="8dp" android:drawableTint="#00D5FF"/>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="6dp" android:background="#16485F"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
                <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="42" android:layout_marginEnd="8dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/ic_note" android:padding="14dp" android:alpha="0.45" android:scaleType="fitCenter" android:background="@drawable/future_mini" android:contentDescription="@null"/>
                    <ImageView android:id="@+id/cover" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:contentDescription="Portada"/>
                </FrameLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="58" android:orientation="vertical">
                    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sin reproducción" android:textColor="#F3F8FF" android:textSize="15sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end"/>
                    <TextView android:id="@+id/artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Elegir música" android:textColor="#91B8D0" android:textSize="12sp" android:maxLines="2" android:ellipsize="end"/>
                    <TextView android:id="@+id/source" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="#FF9B32" android:textSize="10sp" android:singleLine="true" android:ellipsize="end" android:visibility="gone"/>
                </LinearLayout>
            </LinearLayout>
            <ProgressBar android:id="@+id/progress" style="@android:style/Widget.Material.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="10dp" android:max="1000" android:progress="0" android:progressTint="#00D5FF" android:progressBackgroundTint="#19435B"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageButton android:id="@+id/btnPrev" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/future_dock_button" android:contentDescription="Anterior" android:padding="11dp" android:src="@drawable/ic_prev" android:tint="#B5E8FA" android:scaleType="fitCenter"/>
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
                <ImageButton android:id="@+id/btnPlay" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/future_play" android:contentDescription="Reproducir" android:padding="11dp" android:src="@drawable/ic_play" android:tint="#F3F8FF" android:scaleType="fitCenter"/>
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
                <ImageButton android:id="@+id/btnNext" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/future_dock_button" android:contentDescription="Siguiente" android:padding="11dp" android:src="@drawable/ic_next" android:tint="#B5E8FA" android:scaleType="fitCenter"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="18" android:background="@drawable/future_dock" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="4dp" android:paddingBottom="4dp">
        <TextView android:id="@+id/dockMaps" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/future_dock_button" android:clickable="true" android:focusable="true" android:gravity="center" android:paddingTop="8dp" android:paddingBottom="6dp" android:drawableTop="@drawable/ic_map" android:drawableTint="#B5E8FA" android:drawablePadding="3dp" android:text="Mapas" android:textSize="13sp" android:textStyle="bold" android:textColor="#F3F8FF"/>
        <TextView android:id="@+id/dockMusic" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/future_dock_button" android:clickable="true" android:focusable="true" android:gravity="center" android:paddingTop="8dp" android:paddingBottom="6dp" android:drawableTop="@drawable/ic_music" android:drawableTint="#B5E8FA" android:drawablePadding="3dp" android:text="Música" android:textSize="13sp" android:textStyle="bold" android:textColor="#F3F8FF"/>
        <TextView android:id="@+id/dockRadio" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/future_dock_button" android:clickable="true" android:focusable="true" android:gravity="center" android:paddingTop="8dp" android:paddingBottom="6dp" android:drawableTop="@drawable/ic_radio" android:drawableTint="#B5E8FA" android:drawablePadding="3dp" android:text="Radio FM" android:textSize="13sp" android:textStyle="bold" android:textColor="#F3F8FF"/>
        <TextView android:id="@+id/dockPhone" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/future_dock_button" android:clickable="true" android:focusable="true" android:gravity="center" android:paddingTop="8dp" android:paddingBottom="6dp" android:drawableTop="@drawable/ic_phone" android:drawableTint="#B5E8FA" android:drawablePadding="3dp" android:text="Teléfono" android:textSize="13sp" android:textStyle="bold" android:textColor="#F3F8FF"/>
        <TextView android:id="@+id/dockApps" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/future_dock_button" android:clickable="true" android:focusable="true" android:gravity="center" android:paddingTop="8dp" android:paddingBottom="6dp" android:drawableTop="@drawable/ic_apps" android:drawableTint="#B5E8FA" android:drawablePadding="3dp" android:text="Apps" android:textSize="13sp" android:textStyle="bold" android:textColor="#F3F8FF"/>
        <TextView android:id="@+id/dockSettings" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/future_dock_button" android:clickable="true" android:focusable="true" android:gravity="center" android:paddingTop="8dp" android:paddingBottom="6dp" android:drawableTop="@drawable/ic_settings" android:drawableTint="#B5E8FA" android:drawablePadding="3dp" android:text="Ajustes" android:textSize="13sp" android:textStyle="bold" android:textColor="#F3F8FF"/>
    </LinearLayout>
</LinearLayout>
